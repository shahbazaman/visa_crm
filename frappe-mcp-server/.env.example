# Production Frappe CRM Cloud Configuration
FRAPPE_BASE_URL=https://middleeast.frappe.cloud
FRAPPE_API_KEY=your_frappe_api_key_here
FRAPPE_API_SECRET=your_frappe_api_secret_here
HTTP_TIMEOUT=15.0

# Internal Fallback Bearer Token (for CLI / script testing)
MCP_AUTH_TOKEN=your_secure_internal_mcp_auth_token_here

# Google Gemini Spark OAuth 2.0 Credentials (Dedicated for Gemini Connected App)
GEMINI_CLIENT_ID=gemini-spark-client
GEMINI_CLIENT_SECRET=your_gemini_client_secret_here
OAUTH_JWT_SECRET=your_jwt_signing_secret_here

# MCP Server Host and Public URL
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PUBLIC_URL=https://crm-mcp.yourdomain.com
