{
 "align_labels_right": 0,
 "creation": "2026-09-10 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Employee Letter",
 "doctype": "Print Format",
 "font_size": 14,
 "format_data": null,
 "html": "<div class=\"letter-container\" style=\"font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1f2937; line-height: 1.6; padding: 20px 0;\">\n    {% if letter_head %}\n    <div class=\"letter-head\" style=\"margin-bottom: 30px;\">\n        {{ letter_head }}\n    </div>\n    {% endif %}\n\n    <div class=\"letter-meta\" style=\"display: flex; justify-content: space-between; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 25px;\">\n        <div>\n            <span style=\"font-weight: 600; color: #4b5563; font-size: 13px;\">REFERENCE:</span>\n            <div style=\"font-size: 15px; font-weight: 700; color: #111827;\">{{ doc.name }}</div>\n        </div>\n        <div style=\"text-align: right;\">\n            <span style=\"font-weight: 600; color: #4b5563; font-size: 13px;\">DATE:</span>\n            <div style=\"font-size: 15px; font-weight: 700; color: #111827;\">{{ frappe.utils.formatdate(doc.letter_date, \"medium\") }}</div>\n        </div>\n    </div>\n\n    <div class=\"letter-header\" style=\"text-align: center; margin-bottom: 35px;\">\n        <h2 style=\"font-size: 22px; font-weight: 800; color: #1e3a8a; text-transform: uppercase; letter-spacing: 0.05em; margin: 0;\">\n            {{ doc.letter_type }}\n        </h2>\n    </div>\n\n    <div class=\"letter-body\" style=\"font-size: 14.5px; color: #374151; margin-bottom: 40px;\">\n        {{ doc.content }}\n    </div>\n\n    {% if doc.letter_type == \"Increment Letter\" and doc.previous_salary and doc.new_salary %}\n    <div class=\"salary-breakdown\" style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; margin-bottom: 35px;\">\n        <h4 style=\"margin: 0 0 12px 0; color: #1f2937; font-size: 14px; font-weight: 700; text-transform: uppercase;\">Compensation Revision Summary</h4>\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 13.5px;\">\n            <tr>\n                <td style=\"padding: 6px 0; color: #6b7280;\">Previous Monthly Gross:</td>\n                <td style=\"padding: 6px 0; text-align: right; font-weight: 600;\">INR {{ \"{:,.2f}\".format(doc.previous_salary) }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 6px 0; color: #6b7280;\">Revised Monthly Gross:</td>\n                <td style=\"padding: 6px 0; text-align: right; font-weight: 700; color: #047857;\">INR {{ \"{:,.2f}\".format(doc.new_salary) }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 6px 0; color: #6b7280;\">Increment Amount (%):</td>\n                <td style=\"padding: 6px 0; text-align: right; font-weight: 600; color: #047857;\">+INR {{ \"{:,.2f}\".format(doc.increment_amount) }} ({{ doc.increment_percentage }}%)</td>\n            </tr>\n            <tr style=\"border-top: 1px solid #e5e7eb;\">\n                <td style=\"padding: 8px 0 0 0; color: #111827; font-weight: 700;\">Revised Annual CTC:</td>\n                <td style=\"padding: 8px 0 0 0; text-align: right; font-weight: 800; color: #111827;\">INR {{ \"{:,.2f}\".format(doc.annual_ctc) }}</td>\n            </tr>\n        </table>\n    </div>\n    {% endif %}\n\n    <div class=\"signatory-block\" style=\"margin-top: 50px; display: flex; justify-content: space-between;\">\n        <div style=\"width: 250px;\">\n            <p style=\"margin-bottom: 60px; font-size: 13px; color: #6b7280;\">For <strong>{{ frappe.db.get_value('Company', doc.company, 'company_name') or doc.company }}</strong>,</p>\n            <div style=\"border-top: 1px dashed #9ca3af; padding-top: 8px;\">\n                <p style=\"margin: 0; font-weight: 700; color: #111827;\">{{ frappe.db.get_value('Employee', doc.authorized_signatory, 'employee_name') or 'Authorized Signatory' }}</p>\n                <p style=\"margin: 0; font-size: 12.5px; color: #6b7280;\">{{ doc.signatory_designation or 'Human Resources' }}</p>\n            </div>\n        </div>\n        {% if doc.letter_type in [\"Offer Letter\", \"Appointment Letter\"] %}\n        <div style=\"width: 250px; text-align: right;\">\n            <p style=\"margin-bottom: 60px; font-size: 13px; color: #6b7280;\">Accepted and Agreed:</p>\n            <div style=\"border-top: 1px dashed #9ca3af; padding-top: 8px;\">\n                <p style=\"margin: 0; font-weight: 700; color: #111827;\">{{ doc.applicant_name or 'Candidate Signature' }}</p>\n                <p style=\"margin: 0; font-size: 12.5px; color: #6b7280;\">Date: ____________________</p>\n            </div>\n        </div>\n        {% endif %}\n    </div>\n</div>",
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
